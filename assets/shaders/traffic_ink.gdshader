// Generated by tools/build_traffic_shaders.py from ink.gdshader
shader_type spatial;
render_mode unshaded, cull_front;
uniform float width_pixels = 1.6;
// Draw the existing wheel geometry with the body, retaining axle rotation.
uniform float wheel_roll = 0.0;
uniform float wheel_steer = 0.0;
void pose_traffic_wheel(inout vec3 point, inout vec3 normal, vec2 axle, vec2 wheel) {
    float kind = wheel.x;
    if (kind < 0.5) { return; }
    vec3 pivot = vec3(axle.x, wheel.y, axle.y);
    float c = cos(wheel_roll);
    float s = sin(wheel_roll);
    mat3 roll = mat3(vec3(1.0,0.0,0.0),vec3(0.0,c,s),vec3(0.0,-s,c));
    float yaw = kind < 1.5 ? wheel_steer : 0.0;
    c = cos(yaw); s = sin(yaw);
    mat3 steer = mat3(vec3(c,0.0,-s),vec3(0.0,1.0,0.0),vec3(s,0.0,c));
    mat3 pose = steer * roll;
    point = pivot + pose * (point-pivot);
    normal = pose * normal;
}

void vertex() {
    pose_traffic_wheel(VERTEX, NORMAL, UV, UV2);
    vec4 view = MODELVIEW_MATRIX * vec4(VERTEX, 1.0);
    vec4 clip = PROJECTION_MATRIX * view;
    vec3 n = MODELVIEW_NORMAL_MATRIX * NORMAL;
    vec2 projected = (PROJECTION_MATRIX * vec4(n, 0.0)).xy;
    vec2 direction = projected / max(length(projected), 0.001);
    float fade = mix(1.0, 0.4, smoothstep(80.0, 450.0, -view.z));
    clip.xy += direction * width_pixels * fade * 2.0 / VIEWPORT_SIZE * clip.w;
    POSITION = clip;
}
void fragment() { ALBEDO = vec3(0.035, 0.040, 0.062); }
